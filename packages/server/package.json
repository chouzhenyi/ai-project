{
  "name": "server",
  "private": true,
  "scripts": {
    "dev": "tsc && node --watch dist/main.js",
    "dev:watch": "concurrently -n tsc,node -c blue,green \"tsc --watch\" \"sleep 3 && node --watch dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@advanced/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.0",
    "better-sqlite3": "^11.0.0",
    "concurrently": "^9.0.0",
    "drizzle-orm": "^0.40.0",
    "openai": "^4.0.0",
    "qrcode": "^1.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.33.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.2"
  }
}
